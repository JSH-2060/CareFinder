<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.carefinder.dao.member.MemberAccountDAO">

    <select id="findByMno"
            parameterType="long"
            resultType="com.carefinder.dto.member.MemberAccountDTO">

        SELECT
            mno,
            name,
            email,
            phonenumber
        FROM member
        WHERE mno = #{mno}

    </select>

    <update id="updateAccountInfo">
        UPDATE member
        SET
            name = #{name},
            phonenumber = #{phonenumber}
        WHERE mno = #{mno}
    </update>

    <update id="withdraw">
        UPDATE member
        SET deleted = 1
        WHERE mno = #{mno}
    </update>

</mapper>