<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.carefinder.dao.height.HeightDAO">

    <!-- ==========================
         키 목록 조회 (자녀 기준)
         ========================== -->
    <select id="findByChildId" resultType="com.carefinder.dto.height.HeightDTO">
        SELECT
            heightId,
            childId,
            height,
            recordDate,
            created_at AS createdAt
        FROM height_record
        WHERE childId = #{childId}
        ORDER BY recordDate DESC
    </select>

    <!-- ==========================
         키 단건 조회 (수정용)
         ========================== -->
    <select id="findById" resultType="com.carefinder.dto.height.HeightDTO">
        SELECT
            heightId,
            childId,
            height,
            recordDate,
            created_at AS createdAt
        FROM height_record
        WHERE heightId = #{heightId}
    </select>

    <!-- ==========================
         키 기록 추가
         ========================== -->
    <insert id="insert">
        INSERT INTO height_record
        (
            childId,
            height,
            recordDate
        )
        VALUES
            (
                #{childId},
                #{height},
                #{recordDate}
            )
    </insert>

    <!-- ==========================
         키 기록 수정
         ========================== -->
    <update id="update">
        UPDATE height_record
        SET
            height = #{height},
            recordDate = #{recordDate}
        WHERE heightId = #{heightId}
    </update>

    <!-- ==========================
         키 기록 삭제
         ========================== -->
    <delete id="delete">
        DELETE FROM height_record
        WHERE heightId = #{heightId}
    </delete>

    <!-- ==========================
         자녀 목록 (childSelect 용)
         child 테이블 camelCase 기준
         ========================== -->
    <select id="getChildList" resultType="com.carefinder.dto.child.ChildDTO">
        SELECT
            childId,
            childName,
            gender,
            birth
        FROM child
        WHERE mno = #{mno}
        ORDER BY childId
    </select>

</mapper>
