<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.carefinder.dao.member.NormalLoginDAO">
    <select id="findById"
            parameterType="com.carefinder.dto.member.NormalLoginDTO"
            resultType="com.carefinder.dto.member.NormalLoginDTO">

        SELECT mno, id, pw, name, email, age, gender, phonenumber, birth
        FROM member
        WHERE id = #{id}

    </select>

</mapper>